# מעתיקים מהפרויקט ב-supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# מפתח נוסף - נמצא באותו מקום ב-Supabase (Project Settings > API > service_role)
# חשוב: זה מפתח בעל הרשאות מלאות. לעולם לא לחשוף אותו בצד לקוח (בלי NEXT_PUBLIC_ בהתחלה - זה מכוון)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# מפתח לחתימת session tokens של לקוחות הגלריה (lib/session.ts).
# ליצור ערך אקראי חזק, למשל בטרמינל: openssl rand -base64 32
# בלי הערך הזה כל session אפשר לזייף - חובה בפרודקשן, ולעולם לא לחשוף בצד לקוח.
SESSION_SECRET=replace-with-a-long-random-value

# סוד להגנה על app/api/cron/tick/route.ts (מסמן גלריות שפג תוקפן + שולח תזכורות).
# ליצור ערך אקראי חזק כמו SESSION_SECRET. אם מוגדר גם ב-Vercel, Vercel Cron
# שולח אותו אוטומטית כ-Authorization: Bearer - ראו README ("תזכורות וסטטוס אוטומטי").
CRON_SECRET=replace-with-another-long-random-value

# אופציונלי - בלי זה, app/api/cron/tick עדיין מסמן גלריות שפג תוקפן, רק מדלג
# על שליחת מיילים בפועל (ומדפיס אזהרה ללוג). ליצור מפתח ב-resend.com (יש טיר חינמי).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# אופציונלי - כתובת האתר בפרודקשן, לבניית קישורי גלריה במיילי תזכורת.
# בלי זה נופלים חזרה על מקור הבקשה (מספיק כברירת מחדל/לפיתוח מקומי).
NEXT_PUBLIC_SITE_URL=

# כתובת המייל של מנהלת המערכת - היחידה שיכולה לגשת ל-/dashboard/admin ולסמן
# חשבונות צלמים כ"ללא הגבלה" (אחרי שהן שילמו). ראו app/api/admin/*.
ADMIN_EMAIL=

# מעבר אחסון תמונות מ-Supabase Storage (חשבון חינמי מלא) ל-Cloudflare R2 -
# 10GB חינם ואפס עלות תעבורה. יוצרים ב-Cloudflare: bucket פרטי (לא r2.dev
# ציבורי) + API token עם הרשאות קריאה/כתיבה אליו, ראו Project Settings > R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# סוד להגנה על app/api/admin/migrate-storage/route.ts (מעביר קבצים קיימים
# מ-Supabase Storage ל-R2, batch אחרי batch) - אותו דפוס בדיוק כמו CRON_SECRET
# למעלה. אפשר להסיר את המשתנה הזה לגמרי אחרי שהמעבר אומת כהושלם במלואו -
# הוא לא נחוץ יותר ברגע שאין עוד קבצים ישנים להעביר.
MIGRATION_SECRET=replace-with-another-long-random-value
